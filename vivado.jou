set v [get_hw_vios hw_vio_3]
set cmd [get_hw_probes mgmt_command -of_objects $v]
set status [get_hw_probes mgmt_status -of_objects $v]
# Record previous completion count
refresh_hw_vio $v
scan [get_property INPUT_VALUE $status] %x old
set old_count [expr {$old >> 16}]
# Read Si5341 register 0x000C, page 0
set_property OUTPUT_VALUE 004140770C $cmd
commit_hw_vio $v
after 200
refresh_hw_vio $v
# Decode result
scan [get_property INPUT_VALUE $status] %x n
set count [expr {$n >> 16}]
set data [expr {($n >> 8) & 255}]
set err [expr {($n >> 4) & 15}]
set success [expr {($n >> 2) & 1}]
set busy [expr {$n & 1}]
puts [format "Register 0x000C = 0x%02X" $data]
puts "Count: $old_count -> $count"
puts "Error=$err Success=$success Busy=$busy"
if {$count == $old_count + 1 && $err == 0 && $success && !$busy} {
    puts "SYSINCAL = [expr {$data & 1}]"
    puts "LOSXAXB  = [expr {($data >> 1) & 1}]"
    puts "LOSREF   = [expr {($data >> 2) & 1}]"
    puts "LOL      = [expr {($data >> 3) & 1}]"
} else {
    puts "Read not confirmed; do not interpret status bits."
}
set v [get_hw_vios hw_vio_3]
set cmd [get_hw_probes mgmt_command -of_objects $v]
set status [get_hw_probes mgmt_status -of_objects $v]
refresh_hw_vio $v
scan [get_property INPUT_VALUE $status] %x old
# Read U7 register 0x0102 (page 1)
set_property OUTPUT_VALUE 00C3407702 $cmd
commit_hw_vio $v
after 200
refresh_hw_vio $v
scan [get_property INPUT_VALUE $status] %x n
set count [expr {$n >> 16}]
set data [expr {($n >> 8) & 255}]
set err [expr {($n >> 4) & 15}]
set ok [expr {($n & 7) == 6 && $err == 0 && $count == ($old >> 16) + 1}]
puts [format "Register 0x0102 = 0x%02X | count=%d error=%d success=%d" $data $count $err $ok]
if {$ok} {
    puts "OUTALL_DISABLE_LOW = [expr {$data & 1}]"
} else {
    puts "READ FAILED - do not interpret register value"
}
set v [get_hw_vios hw_vio_3]
set cmd [get_hw_probes mgmt_command -of_objects $v]
set status [get_hw_probes mgmt_status -of_objects $v]
refresh_hw_vio $v
scan [get_property INPUT_VALUE $status] %x old
set expected [expr {$old >> 16}]
# Last command had request bit 31 = 1, so start with 0
set toggle 0
foreach offset {0x62 0x63 0x64} {
    set value [expr {
        ($toggle << 31) |
        (1 << 30) |
        (2 << 25) |
        (1 << 24) |
        (0x40 << 16) |
        (0x77 << 8) |
        $offset
    }]

    set_property OUTPUT_VALUE [format %010X $value] $cmd
    commit_hw_vio $v
    after 200
    refresh_hw_vio $v

    scan [get_property INPUT_VALUE $status] %x n
    incr expected

    if {($n >> 16) != $expected || (($n >> 4) & 15) != 0 || ($n & 7) != 6} {
        error "I2C read failed at offset $offset"
    }

    puts [format "0x%04X = 0x%02X" [expr {0x0200 + $offset}] [expr {($n >> 8) & 255}]]

    set toggle [expr {1 - $toggle}]
}
set v [get_hw_vios hw_vio_3]
set cmd [get_hw_probes mgmt_command -of_objects $v]
set status [get_hw_probes mgmt_status -of_objects $v]
refresh_hw_vio $v
scan [get_property INPUT_VALUE $status] %x old
set expected [expr {$old >> 16}]
# Previous request toggle was 0
set toggle 1
foreach {page offset} {
    10 0x03
    10 0x05
    11 0x4A
} {
    set value [expr {
        ($toggle << 31) |
        (1 << 30) |
        ($page << 25) |
        (1 << 24) |
        (0x40 << 16) |
        (0x77 << 8) |
        $offset
    }]

    set_property OUTPUT_VALUE [format %010X $value] $cmd
    commit_hw_vio $v
    after 200
    refresh_hw_vio $v

    scan [get_property INPUT_VALUE $status] %x n
    incr expected

    if {($n >> 16) != $expected || (($n >> 4) & 15) != 0 || ($n & 7) != 6} {
        error "I2C read failed"
    }

    puts [format "0x%02X%02X = 0x%02X" $page $offset [expr {($n >> 8) & 255}]]

    set toggle [expr {1 - $toggle}]
}
set v [get_hw_vios hw_vio_3]
set cmd [get_hw_probes mgmt_command -of_objects $v]
set status [get_hw_probes mgmt_status -of_objects $v]
refresh_hw_vio $v
scan [get_property INPUT_VALUE $status] %x old
