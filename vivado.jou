set v [get_hw_vios hw_vio_3]
set cmd_probe [get_hw_probes mgmt_command -of_objects $v]
set status_probe [get_hw_probes mgmt_status -of_objects $v]
set expected_count 388
foreach {reg cmd} {
    0131 00C3407731
    0132 0043407732
    0133 00C3407733
} {
    set_property OUTPUT_VALUE $cmd $cmd_probe
    commit_hw_vio $v
    after 100
    refresh_hw_vio $v

    scan [get_property INPUT_VALUE $status_probe] %x n

    set count [expr {$n >> 16}]
    set data [expr {($n >> 8) & 255}]
    set err [expr {($n >> 4) & 15}]
    set ok [expr {($n & 7) == 6}]

    puts [format "Register 0x%s = 0x%02X | count=%d error=%d success=%d" $reg $data $count $err $ok]

    incr expected_count
    if {!$ok || $err != 0 || $count != $expected_count} {
        error "Unexpected I2C status; stopping"
    }
}
